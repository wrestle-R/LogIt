<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="6dp" android:paddingEnd="6dp" android:background="@drawable/widget_bg">
<ImageView android:id="@+id/quick_log" android:layout_width="44dp" android:layout_height="44dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_open" android:padding="10dp" android:contentDescription="Open activity"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toStartOf="@id/quick_log" android:layout_centerVertical="true" android:orientation="vertical"><TextView android:text="Read" android:includeFontPadding="false" android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="#fafafa"/><TextView android:text="3 today" android:includeFontPadding="false" android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#a1a1aa"/><TextView android:id="@+id/quick_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to log" android:textSize="10sp" android:textColor="#71717a"/></LinearLayout>
<FrameLayout android:id="@+id/plot" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"><ImageView android:id="@+id/graph" android:layout_width="0dp" android:layout_height="0dp"/><TextView android:id="@+id/overlay_log" android:layout_width="0dp" android:layout_height="0dp"/></FrameLayout></RelativeLayout>
