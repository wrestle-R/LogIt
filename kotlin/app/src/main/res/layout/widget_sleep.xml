<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sleep_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/sleep_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Sleep"
        android:textColor="#B5B6BE"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/sleep_widget_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="7h 20m"
        android:textColor="#FAFAFA"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sleep_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="of 8h goal"
        android:textColor="#B5B6BE"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/sleep_widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:progressDrawable="@drawable/sleep_widget_progress"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/sleep_widget_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="9dp"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sleep_widget_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Last 7 nights"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
