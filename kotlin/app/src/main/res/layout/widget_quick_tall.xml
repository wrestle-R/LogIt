<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp">
<ImageView android:id="@+id/quick_log" android:layout_width="44dp" android:layout_height="44dp" android:layout_alignParentEnd="true" android:layout_alignParentTop="true" android:src="@drawable/ic_open" android:padding="10dp" android:contentDescription="Open activity"/>
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toStartOf="@id/quick_log" android:layout_alignParentTop="true" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="#fafafa"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:orientation="vertical"><TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" android:textColor="#fafafa"/><TextView android:id="@+id/quick_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to log" android:textSize="11sp" android:textColor="#a1a1aa"/></LinearLayout>
<FrameLayout android:id="@+id/plot" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"><ImageView android:id="@+id/graph" android:layout_width="0dp" android:layout_height="0dp"/><TextView android:id="@+id/overlay_log" android:layout_width="0dp" android:layout_height="0dp"/></FrameLayout></RelativeLayout>
